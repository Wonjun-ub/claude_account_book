# =============================================================================
# 백엔드 (.NET 8/9 Web API)
# =============================================================================

# Supabase PostgreSQL 연결 문자열
# 형식: Host=db.xxxx.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your_password;SSL Mode=Require;Trust Server Certificate=true
DATABASE_URL=Host=localhost;Port=5432;Database=budget_tracker;Username=postgres;Password=your_password

# CORS 허용 오리진 (쉼표 구분)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.onrender.com

# ASP.NET Core 환경 (Development / Production)
ASPNETCORE_ENVIRONMENT=Development

# =============================================================================
# 프론트엔드 (Vue3 + Vite)
# =============================================================================

# 백엔드 API 기본 URL
VITE_API_URL=http://localhost:5000

# =============================================================================
# 배포 (Render)
# =============================================================================

# Render 서비스 URL (배포 후 설정)
# RENDER_BACKEND_URL=https://budget-tracker-api.onrender.com
# RENDER_FRONTEND_URL=https://budget-tracker.onrender.com
