{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:staging": "run-p type-check build-only:staging",
    "build:production": "run-p type-check build-only:production",
    "preview": "vite preview",
    "build-only": "vite build",
    "build-only:staging": "vite build --mode staging",
    "build-only:production": "vite build --mode production",
    "type-check": "vue-tsc --build",
    "test": "cross-env NODE_OPTIONS=\"--require ./vitest.preload.cjs\" vitest run",
    "test:watch": "cross-env NODE_OPTIONS=\"--require ./vitest.preload.cjs\" vitest",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "dayjs": "^1.11.20",
    "pinia": "^2.2.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.4",
    "@tsconfig/node16": "^16.1.3",
    "@types/node": "^16.18.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/coverage-v8": "^0.34.6",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.0",
    "cross-env": "7.0.3",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.28.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.3.3",
    "vite": "^4.5.5",
    "vitest": "^0.34.6",
    "vue-tsc": "^1.8.27"
  },
  "engines": {
    "node": "16.x"
  }
}
